# --- 2FA ---
RATE_LIMIT_2FA_PER_MINUTE=5
TOTP_USED_TTL_SECONDS=120
APP_ENV=development
DEBUG=false
CORS_ALLOWED_ORIGINS=["https://echats-808c4.web.app"]
CORS_DEV_ORIGINS=["http://127.0.0.1:3002","http://localhost:3002"]
# Opt-in exceptionnel pour un test contrôlé en production; laisser false par défaut.
ENABLE_TEMPORARY_CORS=false
CORS_TEMPORARY_ORIGINS=[]

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/echats_pro

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Firebase (JSON du compte de service, sur une seule ligne) ---
FIREBASE_CREDENTIALS_JSON=

# --- ECHATS IA (api.echats.ai) ---
ECHATS_AI_BACKEND_URL=https://blackhawk-ai-core.onrender.com
ECHATS_AI_API_KEY=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Paiements ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
MOBILE_MONEY_API_KEY=
PARABEN_REVENUE_ACCOUNT=

# --- Email ---
SENDGRID_API_KEY=
RESEND_API_KEY=

# --- Labs ---
JUDGE0_API_URL=
GITHUB_TOKEN=

# --- JWT interne (générer avec: openssl rand -hex 32) ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Chambre Close : clé Fernet dédiée (générer avec Fernet.generate_key() en Python) ---
CHAMBER_CLOSE_ENCRYPTION_KEY=

# --- Certificats : signature HMAC (générer avec: openssl rand -hex 32) ---
CERTIFICATE_SIGNING_SECRET=
